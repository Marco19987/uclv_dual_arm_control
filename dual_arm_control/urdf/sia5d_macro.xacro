<?xml version="1.0"?>
<!-- Generated: kinematics identical to the DH model used by the controllers (see README).
     Visual meshes: sia5d (see meshes/LICENSES.md). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="motoman_sia5d" params="prefix:=''">
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/base.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}joint_s" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_s"/>
      <origin xyz="0 0 0.3095" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.141593" upper="3.141593" effort="100" velocity="3.5000"/>
    </joint>
    <link name="${prefix}link_s">
      <visual>
        <origin xyz="0 0 0.0005" rpy="0 0 0"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/link_s.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}joint_l" type="revolute">
      <parent link="${prefix}link_s"/>
      <child link="${prefix}link_l"/>
      <origin xyz="0 0 0" rpy="-1.570796327 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.919862" upper="1.919862" effort="100" velocity="3.5000"/>
    </joint>
    <link name="${prefix}link_l">
      <visual>
        <origin xyz="0 -0.0005 0" rpy="1.570796327 0 0"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/link_l.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}joint_e" type="revolute">
      <parent link="${prefix}link_l"/>
      <child link="${prefix}link_e"/>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.967060" upper="2.967060" effort="100" velocity="3.5000"/>
    </joint>
    <link name="${prefix}link_e">
      <visual>
        <origin xyz="0 0 0.2705" rpy="0 0 0"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/link_e.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}joint_u" type="revolute">
      <parent link="${prefix}link_e"/>
      <child link="${prefix}link_u"/>
      <origin xyz="0.085 0 0.27" rpy="0 -1.570796327 1.570796327"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.570796" upper="2.007129" effort="100" velocity="3.5000"/>
    </joint>
    <link name="${prefix}link_u">
      <visual>
        <origin xyz="0.0005 0 0" rpy="-1.570796327 0 -1.570796327"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/link_u.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}joint_r" type="revolute">
      <parent link="${prefix}link_u"/>
      <child link="${prefix}link_r"/>
      <origin xyz="0.06 0 0" rpy="1.570796327 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-3.141593" upper="3.141593" effort="100" velocity="3.5000"/>
    </joint>
    <link name="${prefix}link_r">
      <visual>
        <origin xyz="0.0005 0 0.27" rpy="0 -1.570796327 -3.141592654"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/link_r.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}joint_b" type="revolute">
      <parent link="${prefix}link_r"/>
      <child link="${prefix}link_b"/>
      <origin xyz="0 0 0.27" rpy="-1.570796327 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.919862" upper="1.919862" effort="100" velocity="4.0150"/>
    </joint>
    <link name="${prefix}link_b">
      <visual>
        <origin xyz="0.0005 0 0" rpy="-1.570796327 0 -1.570796327"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/link_b.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}joint_t" type="revolute">
      <parent link="${prefix}link_b"/>
      <child link="${prefix}link_t"/>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-3.141593" upper="3.141593" effort="100" velocity="6.1100"/>
    </joint>
    <link name="${prefix}link_t">
      <visual>
        <origin xyz="0.0005 0 0.134" rpy="0 -1.570796327 -3.141592654"/>
        <geometry><mesh filename="package://dual_arm_control/meshes/sia5d/link_t.dae"/></geometry>
      </visual>
    </link>
    <joint name="${prefix}tool0_joint" type="fixed">
      <parent link="${prefix}link_t"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 0.148" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}tool0"/>
  </xacro:macro>
</robot>
